{% extends "base.html.j2" %}
{% block page_head %}
<style>
{% raw %}main {
      max-width: 1000px;
      margin: 40px auto 60px auto;
      padding: 0 20px;
    }
    h2 {
      text-align: center;
      color: #1d5fa3;
      font-size: 2.4rem;
      margin: 0 0 12px;
    }
    .gallery-intro {
      text-align: center;
      color: #5a6c80;
      font-size: 1.05rem;
      margin: 0 auto 32px;
      max-width: 640px;
    }
    .gallery-choice-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin: 20px 0;
    }
    .gallery-choice {
      display: block;
      position: relative;
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 4px 14px rgba(0, 51, 102, 0.12);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.18s ease-out, box-shadow 0.18s ease-out;
    }
    .gallery-choice:hover, .gallery-choice:focus-visible {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(0, 51, 102, 0.2);
      outline: none;
    }
    .gallery-choice .card-cover {
      height: 180px;
      background: linear-gradient(135deg, #2e7dd1, #1d5fa3);
      display: grid;
      place-items: center;
      color: white;
    }
    .gallery-choice .card-cover svg {
      width: 68px;
      height: 68px;
      opacity: 0.95;
    }
    .gallery-choice .card-body {
      padding: 20px 22px 24px;
    }
    .gallery-choice h3 {
      margin: 0 0 6px;
      color: #1d3557;
      font-size: 1.3rem;
    }
    .gallery-choice p {
      margin: 0;
      color: #5a6c80;
      font-size: 0.98rem;
      line-height: 1.5;
    }
    .gallery-choice .arrow {
      display: inline-block;
      margin-top: 10px;
      color: #2e7dd1;
      font-weight: 600;
      font-size: 0.95rem;
    }
{% endraw %}
</style>
{% endblock %}
{% block body %}
<main id="main-content">
<h2>Gallery</h2>
<p class="gallery-intro">Take a peek inside — browse photos of daily life at the centre, or watch short video clips of our programs.</p>
<div class="gallery-choice-grid">
<a class="gallery-choice" href="gallery-photos.html">
<div class="card-cover" aria-hidden="true">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
</div>
<div class="card-body">
<h3>Photos</h3>
<p>Snapshots of classrooms, playtime, art projects, and events.</p>
<span class="arrow">Browse photos →</span>
</div>
</a>
<a class="gallery-choice" href="gallery-videos.html">
<div class="card-cover" aria-hidden="true">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
</div>
<div class="card-body">
<h3>Videos</h3>
<p>Short clips of programs, celebrations, and everyday moments.</p>
<span class="arrow">Watch videos →</span>
</div>
</a>
</div>
</main>
{% endblock %}
