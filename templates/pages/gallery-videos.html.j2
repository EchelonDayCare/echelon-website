{% extends "base.html.j2" %}
{% block page_head %}
<style>
{% raw %}main {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 16px;
    }

    h2 {
      margin: 10px 0 18px;
      color: #1d5fa3;
      font-size: 2rem;
      text-align: center;
    }

    .video-wrap {
      position: relative;
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      margin: 20px auto;
    }

    .video-wrap video {
      width: 100%;
      height: auto;
      display: block;
    }

    .tour-intro {
      max-width: 800px;
      margin: 0 auto 10px;
      text-align: center;
      color: var(--c-muted, #5a6c80);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .now-playing {
      max-width: 900px;
      margin: 14px auto 6px;
      text-align: center;
    }

    .now-playing h3 {
      margin: 0 0 4px;
      color: #1d5fa3;
      font-size: 1.25rem;
    }

    .now-playing p {
      margin: 0;
      color: var(--c-muted, #5a6c80);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .playlist {
      max-width: 1100px;
      margin: 22px auto 40px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
      padding: 0;
      list-style: none;
    }

    .playlist button {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
      padding: 6px;
      border: 2px solid transparent;
      background: white;
      border-radius: 10px;
      cursor: pointer;
      transition: transform 0.15s ease-out, border-color 0.15s ease-out, box-shadow 0.15s ease-out;
      text-align: left;
      font: inherit;
    }

    .playlist button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0,0,0,0.12);
    }

    .playlist button.is-active {
      border-color: #1d5fa3;
      box-shadow: 0 4px 12px rgba(29,95,163,0.28);
    }

    .playlist .thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      background: #0f172a center/cover no-repeat;
      border-radius: 6px;
      overflow: hidden;
    }

    .playlist .thumb::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(0,0,0,0) 40%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }

    .playlist .play-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.92);
      display: grid;
      place-items: center;
      pointer-events: none;
      z-index: 1;
      transition: transform 0.15s ease-out;
    }

    .playlist button:hover .play-badge {
      transform: translate(-50%, -50%) scale(1.06);
    }

    .playlist .play-badge svg {
      width: 20px;
      height: 20px;
      color: #1d5fa3;
    }

    .playlist .video-title {
      font-weight: 600;
      color: #1d3557;
      font-size: 0.95rem;
      line-height: 1.3;
    }
{% endraw %}
</style>
{% endblock %}
{% block body %}
<main id="main-content">
<p class="breadcrumb" style="margin: 0 0 8px; font-size: 0.9rem; color: #666;"><a href="gallery.html" style="text-decoration: none; color: #2e7dd1;">← Back to Gallery</a></p>
<h2>{{ gallery_videos.heading }}</h2>
{% if gallery_videos.intro %}<p class="tour-intro">{{ gallery_videos.intro }}</p>{% endif %}

{% set video_list = gallery_videos.videos if gallery_videos.videos is defined and gallery_videos.videos else [] %}
{% set first = video_list[0] if video_list else none %}

{% if first %}
<div class="video-wrap">
<video
id="galVideo"
controls
preload="metadata"
playsinline
poster="{{ asset_prefix }}{{ first.poster }}"
aria-label="{{ gallery_videos.heading }} video player">
<source id="galSource" src="{{ asset_prefix }}{{ first.src }}" type="video/mp4">
Your browser does not support HTML5 video. <a id="galFallback" href="{{ asset_prefix }}{{ first.src }}">Download this video</a> instead.
</video>
</div>

<div class="now-playing">
<h3 id="galNowTitle">{{ first.title }}</h3>
<p id="galNowDesc">{{ first.description }}</p>
</div>
{% else %}
<p style="text-align: center; color: #5a6c80; margin: 40px auto; max-width: 500px;">No videos yet. Check back soon!</p>
{% endif %}

{% if video_list|length > 1 %}
<ul class="playlist" role="list" aria-label="Available gallery videos">
{% for v in video_list %}
<li>
<button type="button" data-src="{{ asset_prefix }}{{ v.src }}" data-poster="{{ asset_prefix }}{{ v.poster }}" data-title="{{ v.title|e }}" data-desc="{{ v.description|default('')|e }}" class="{% if loop.first %}is-active{% endif %}" aria-label="Play {{ v.title }}">
<div class="thumb" style="background-image:url('{{ asset_prefix }}{{ v.poster }}');">
<span class="play-badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
</div>
<span class="video-title">{{ v.title }}</span>
</button>
</li>
{% endfor %}
</ul>
<script>
{% raw %}(function(){
  var video = document.getElementById('galVideo');
  var source = document.getElementById('galSource');
  var fallback = document.getElementById('galFallback');
  var titleEl = document.getElementById('galNowTitle');
  var descEl  = document.getElementById('galNowDesc');
  var buttons = document.querySelectorAll('.playlist button');
  buttons.forEach(function(btn){
    btn.addEventListener('click', function(){
      var src = btn.getAttribute('data-src');
      var poster = btn.getAttribute('data-poster');
      var title = btn.getAttribute('data-title') || '';
      var desc  = btn.getAttribute('data-desc') || '';
      if (source) source.setAttribute('src', src);
      if (fallback) fallback.setAttribute('href', src);
      if (poster) video.setAttribute('poster', poster);
      if (titleEl) titleEl.textContent = title;
      if (descEl) descEl.textContent = desc;
      buttons.forEach(function(b){ b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      video.load();
      var p = video.play();
      if (p && p.catch) p.catch(function(){});
    });
  });
})();{% endraw %}
</script>
{% endif %}

</main>
{% endblock %}