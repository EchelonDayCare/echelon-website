{% extends "base.html.j2" %}
{% block page_head %}
<style>
{% raw %}main {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 16px;
    }

    h2 {
      margin: 10px 0 18px;
      color: #1d5fa3;
      font-size: 2rem;
      text-align: center;
    }

    .video-wrap {
      position: relative; /* Needed for play button */
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      margin: 20px auto;
    }

    .video-wrap video {
      width: 100%;
      height: auto;
      display: block;
    }

    .tour-intro {
      max-width: 800px;
      margin: 0 auto 10px;
      text-align: center;
      color: var(--c-muted, #5a6c80);
      font-size: 1.05rem;
      line-height: 1.6;
    }{% endraw %}
</style>
{% endblock %}
{% block body %}
<main id="main-content">
<h2>{{ tour.heading }}</h2>
<p class="tour-intro">{{ tour.intro }}</p>

<div class="video-wrap">
<video
id="tourVideo"
controls
preload="metadata"
playsinline
poster="{{ asset_prefix }}{{ tour.video_poster }}"
aria-label="{{ tour.video_aria_label }}">
<source src="{{ asset_prefix }}{{ tour.video_src }}" type="video/mp4">
{{ tour.video_fallback_text }} <a href="{{ asset_prefix }}{{ tour.video_src }}">{{ tour.video_fallback_link_label }}</a> instead.
</video>
</div>
</main>
{% endblock %}
