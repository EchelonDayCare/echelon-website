{% extends "base.html.j2" %}
{% block page_head %}
<style>
{% raw %}/* All your previous CSS from before */
/* Updated: Prominent hiring link (3x larger on desktop) */
section {
            padding: 30px 20px;
            text-align: center;
        }

        .hero {
            position: relative;
            background-image: url('assets/img/hero-bg.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: white;
            height: 400px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            z-index: 0;
        }

        .hero h1,
        .hero p {
            position: relative;
            z-index: 1;
        }

        .hero h1 {
            font-size: 2.6em;
            margin-bottom: 14px;
        }

        .hero p {
            font-size: 1.4em;
            line-height: 1.55;
            max-width: 90%;
            margin: 0 auto;
        }

        .features,
        .stats {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }

        .feature-box,
        .stat-box {
            background-color: #d7e7f7;
            padding: 22px;
            margin: 10px;
            border-radius: 8px;
            width: 250px;
            font-size: 1.15rem;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px;
            justify-items: center;
        }

        .gallery-grid img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border: 4px solid #2e7dd1;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .gallery-grid img:hover {
            transform: scale(1.02);
        }

        /* Existing falling stars inside hero */
        .hero {
            overflow: hidden;
        }

        .starfield {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }

        .hero h1,
        .hero p,
        .cta-btn {
            position: relative;
            z-index: 2;
        }

        .star {
            position: absolute;
            top: -60px;
            width: var(--size);
            height: var(--size);
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #ffffff, #ffe29a 45%, rgba(255, 255, 255, 0) 60%);
            filter: drop-shadow(0 0 8px #ffffff);
            opacity: 0.9;
            transform: translateY(0) translateX(0);
            animation: fall var(--dur) linear var(--delay) infinite,
                twinkle 2.2s ease-in-out var(--delay) infinite;
        }

        @keyframes fall {
            to {
                transform: translateY(120%) translateX(var(--drift)) rotate(360deg);
            }
        }

        @keyframes twinkle {
            0%,
            100% {
                opacity: 0.75;
            }

            50% {
                opacity: 1;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .star {
                animation: none;
                opacity: 0.8;
            }
        }

        /* ⭐ Added: Global starfield section */
        .global-starfield {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .global-star {
            position: absolute;
            border-radius: 50%;
            background: white;
            box-shadow: 0 0 10px #fff, 0 0 20px #fff;
            opacity: 0.9;
            animation: globalFall linear forwards;
        }

        @keyframes globalFall {
            0% {
                transform: translateY(-50px);
                opacity: 1;
            }
            100% {
                transform: translateY(110vh);
                opacity: 0;
            }
        }

        /* Modal Styles (unchanged) */
        .modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            max-width: 90%;
            max-height: 80%;
            border-radius: 8px;
        }

        .close,
        .prev,
        .next {
            position: absolute;
            top: 50%;
            color: white;
            font-size: 36px;
            font-weight: bold;
            cursor: pointer;
            user-select: none;
            padding: 10px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 50%;
            transform: translateY(-50%);
            z-index: 10000;
        }

        .close {
            top: 20px;
            right: 30px;
            font-size: 40px;
            transform: none;
        }

        .prev {
            left: 30px;
        }

        .next {
            right: 30px;
        }

        .close:hover,
        .prev:hover,
        .next:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
/* Elegant Enroll Now Button */
        .cta-btn {
            display: inline-block;
            padding: 16px 40px;
            font-size: 1.35rem;
            font-weight: 600;
            border-radius: 50px;
            text-decoration: none;
            color: #16456f;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4, #fad390);
            border: 2px solid #16456f;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease-in-out;
            position: relative;
            z-index: 1;
            margin-top: 60px;
            animation: pulse 1s infinite;
        }

        .cta-btn:hover {
            background: linear-gradient(135deg, #fad390, #fbc2eb, #a6c0fe);
            color: #000;
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

        @media (max-width: 768px) {
.hero {
                height: 300px;
            }

            .hero h1 {
                font-size: 1.85em;
            }

            .hero p {
                font-size: 1.15em;
            }

            .stat-box,
            .feature-box {
                width: 90%;
            }

            .gallery-grid img {
                height: 180px;
            }

            .close,
            .prev,
            .next {
                font-size: 28px;
            }

            /* Show a compact hire button on mobile: smaller, tighter padding, no heavy shadow */
/* Reduce header padding so everything fits */
/* Slightly reduce the h1 size further on very small phones */
            @media (max-width: 420px) {
}
        }{% endraw %}
</style>
{% endblock %}
{% block body %}
<div class="starfield" aria-hidden="true"></div>

<!-- ⭐ Added: Global star background -->
<div class="global-starfield" aria-hidden="true"></div>

<section id="main-content" class="hero">
<h1>{{ home.hero.heading }}</h1>
<p>{{ home.hero.subtext }}</p>
<a href="{{ home.hero.cta_href }}" class="cta-btn">{{ home.hero.cta_label }}</a>
</section>

<section class="gallery">
<h2>{{ home.gallery_preview.heading }}</h2>
<div class="gallery-grid">
{% for img in home.gallery_preview["items"] %}<img src="{{ asset_prefix }}{{ img.src }}" alt="{{ img.alt }}" onclick="openModal({{ loop.index0 }})" loading="lazy" decoding="async" />
{% endfor %}</div>
</section>

<section class="stats">
{% for s in home.stats %}<div class="stat-box">{{ s }}</div>
{% endfor %}</section>

<!-- Modal -->
<div id="imageModal" class="modal" onclick="clickOutside(event)">
<span class="close" onclick="closeModal()">&times;</span>
<span class="prev" onclick="changeImage(-1)">&#10094;</span>
<img class="modal-content" id="modalImg" />
<span class="next" onclick="changeImage(1)">&#10095;</span>
</div>

<script>
{%- set image_srcs = home.gallery_preview["items"] | map(attribute='src') | list -%}
{% raw %}        const imageList = [{% endraw %}{% for src in image_srcs %}"{{ asset_prefix }}{{ src }}"{% if not loop.last %}, {% endif %}{% endfor %}{% raw %}];
        let currentIndex = 0;

        function openModal(index) {
            currentIndex = index;
            document.getElementById("modalImg").src = imageList[currentIndex];
            document.getElementById("imageModal").style.display = "flex";
        }

        function closeModal() {
            document.getElementById("imageModal").style.display = "none";
        }

        function changeImage(direction) {
            currentIndex += direction;
            if (currentIndex < 0) currentIndex = imageList.length - 1;
            if (currentIndex >= imageList.length) currentIndex = 0;
            document.getElementById("modalImg").src = imageList[currentIndex];
        }

        function clickOutside(event) {
            const modal = document.getElementById("imageModal");
            if (event.target === modal) {
                closeModal();
            }
        }
        document.addEventListener("keydown", function(event) {
            const modal = document.getElementById("imageModal");
            if (modal.style.display === "flex") {
                if (event.key === "ArrowLeft") {
                    changeImage(-1);
                } else if (event.key === "ArrowRight") {
                    changeImage(1);
                } else if (event.key === "Escape") {
                    closeModal();
                }
            }
        });{% endraw %}
</script>

<script>
{% raw %}        // Existing hero star script (unchanged)
        (function() {
            const container = document.querySelector('.starfield');
            if (!container) return;
            const STAR_COUNT_DESKTOP = 50;
            const STAR_COUNT_MOBILE = 28;
            const MIN_SIZE = 14;
            const MAX_SIZE = 28;
            const MIN_DUR = 6;
            const MAX_DUR = 12;
            const MAX_DRIFT = 120;
            const isMobile = window.matchMedia('(max-width: 768px)').matches;
            const count = isMobile ? STAR_COUNT_MOBILE : STAR_COUNT_DESKTOP;
            for (let i = 0; i < count; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const size = rand(MIN_SIZE, MAX_SIZE);
                const left = Math.random() * 100;
                const delay = -(Math.random() * MAX_DUR);
                const dur = rand(MIN_DUR, MAX_DUR);
                const drift = (Math.random() * 2 - 1) * MAX_DRIFT;
                star.style.setProperty('--size', size + 'px');
                star.style.left = left + '%';
                star.style.setProperty('--delay', `${delay}s`);
                star.style.setProperty('--dur', `${dur}s`);
                star.style.setProperty('--drift', `${drift}px`);
                container.appendChild(star);
            }
            function rand(min, max) {
                return Math.floor(Math.random() * (max - min + 1)) + min;
            }
        })();{% endraw %}
</script>

<!-- ⭐ Added: Script for global stars -->
<script>
{% raw %}        (function() {
            const container = document.querySelector('.global-starfield');
            if (!container) return;

            function createGlobalStar() {
                const star = document.createElement('div');
                star.classList.add('global-star');

                const size = Math.random() * 8 + 6; // 6-14px
                const startX = Math.random() * window.innerWidth;
                const duration = Math.random() * 3 + 4; // 4-7s fall

                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.left = `${startX}px`;
                star.style.top = `-20px`;
                star.style.animationDuration = `${duration}s`;

                container.appendChild(star);
                setTimeout(() => star.remove(), duration * 1000);
            }

            setInterval(createGlobalStar, 120); // Many stars falling
        })();{% endraw %}
</script>

<section id="faq" class="faq-section" aria-labelledby="faq-heading">
<div class="faq-inner">
<h2 id="faq-heading">{{ home.faq.heading }}</h2>
{% for q in home.faq["items"] %}<details class="faq-item">
<summary>{{ q.question }}</summary>
<p>{{ q.answer }}</p>
</details>
{% endfor %}</div>
</section>
{% endblock %}
{% block faq_schema %}
<script type="application/ld+json">
{{ faq_schema | tojson(indent=2) }}
</script>
{% endblock %}
